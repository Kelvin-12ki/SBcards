# ---- Core (required) -------------------------------------------------------
NODE_ENV=development
PORT=3005
MONGODB_URI=mongodb://localhost:27017/sbcards

# Must be >= 32 chars and not a placeholder — the API refuses to boot otherwise.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---- Firebase Admin (required in production) -------------------------------
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com

# ---- CORS ------------------------------------------------------------------
# Exact origins only — no wildcards. FRONTEND_URL is always allowed; add any
# extras (custom domain, staging) as a comma-separated list in CORS_ORIGINS.
FRONTEND_URL=http://localhost:5174
CORS_ORIGINS=

# ---- Optional --------------------------------------------------------------
# Expose Swagger in production for a debugging session. Leave unset normally.
SWAGGER_ENABLED=

# Mongo pool sizing. Keep maxPoolSize * (instances + 1) under the Atlas
# connection limit for your tier.
MONGO_MAX_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=2

# Set to false only once every schema index exists in the target database.
MONGO_AUTO_INDEX=true

# ---- Email (optional; notifications are disabled without it) ---------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
